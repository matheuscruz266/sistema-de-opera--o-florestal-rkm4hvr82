{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Git: watch and synchronize with GitHub",
      "type": "process",
      "command": "npm",
      "args": [
        "run",
        "git:watch"
      ],
      "isBackground": true,
      "runOptions": {
        "runOn": "folderOpen",
        "instanceLimit": 1
      },
      "presentation": {
        "reveal": "silent",
        "focus": false,
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": {
        "owner": "github-auto-sync",
        "pattern": {
          "regexp": "^(.*)$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^GitHub file watcher active",
          "endsPattern": "^GitHub file watcher stopped"
        }
      }
    }
  ]
}
