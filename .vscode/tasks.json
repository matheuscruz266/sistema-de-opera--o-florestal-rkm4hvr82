{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Git: synchronize with GitHub",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\scripts\\git-auto-sync.ps1"
      ],
      "runOptions": {
        "runOn": "folderOpen",
        "instanceLimit": 1
      },
      "presentation": {
        "reveal": "silent",
        "focus": false,
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": []
    }
  ]
}
